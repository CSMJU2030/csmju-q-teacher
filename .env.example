# ---------------------------------------------------------------------------
# CSMJU2030 subsystem - ตัวอย่าง environment ของ backend
# คัดลอกเป็น backend/.env "ก่อน" รัน pnpm install  (ห้าม commit .env)
# ขั้นตอนเชื่อม Core Hub จริงทั้งหมด: standards/docs/connect-core-hub.md
# ---------------------------------------------------------------------------

NODE_ENV=development
# backend ใช้พอร์ต 42xx · frontend คู่กันใช้ 32xx (3224) และเป็นพอร์ตที่ลงทะเบียน callback
PORT=4224

# ฐานข้อมูลของ subsystem นี้เท่านั้น - ห้ามชี้ไปที่ core_hub
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/change_me_db

# Core Hub (ผู้ให้ identity) - server จริง · อ่านจาก env เสมอ ห้ามเขียนตายในโค้ด
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
# เว็บของ Core Hub ที่ GET /auth/login ส่งเบราว์เซอร์ไป (/sso/authorize) และ POST /auth/logout ส่งไป (/logout)
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# สัญญาที่ตรึงไว้ - ห้ามเปลี่ยนค่าเหล่านี้เอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# ตัวตนของ subsystem - ต้องตรงกับ name ใน Subsystem Registry และ subsystem.yaml
SUBSYSTEM_ID=csmju-q-teacher

# JWKS cache
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5
