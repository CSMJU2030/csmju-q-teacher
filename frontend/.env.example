# Backend (NestJS) ของระบบนี้ — next.config.ts ส่ง /api/*, /auth/login, /auth/callback
# และ /auth/logout ต่อไปที่นี่ · อ่านตอน build เท่านั้น (Docker image ใช้ http://api:4000 แทน)
BACKEND_URL=http://127.0.0.1:4224

# ต้องตรงกับ name ใน Subsystem Registry, subsystem.yaml และ SUBSYSTEM_ID ของ backend
# ใช้ตั้งชื่อคุกกี้ session: csmju_q_teacher_access_token
SUBSYSTEM_ID=csmju-q-teacher

# หน้าเว็บ Core Hub (portal ที่ผู้ใช้ login) — ปุ่ม "กลับ CSMJU Portal" ใน CsmjuAppShell พาไปที่นี่
# ไม่ตั้ง = ไม่แสดงปุ่ม · ต้องเป็นค่าเดียวกับ CORE_HUB_WEB_URL ของ backend
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
