            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TeacherResponse"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMetaModel"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "อาจารย์ที่เปิดเวลาทำการแล้ว (ใช้เลือกดูตาราง)",
        "tags": [
          "teachers"
        ]
      }
    }
  },
  "info": {
    "title": "Q-Teacher API",
    "description": "ระบบนัดหมายเข้าพบอาจารย์ (CSMJU2030) — ตอบเป็น { success, data[, meta] } หรือ { success: false, error } ตามมาตรฐาน api-conventions.md · ต้องมี token ของ Core Hub ทุก endpoint ยกเว้น /api/health",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "csmju_q_teacher_access_token"
      }
    },
    "schemas": {
      "PaginationMetaModel": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 42
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 20
          },
          "totalPages": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "total",
          "page",
          "limit",
          "totalPages"
        ]
      },
      "OfficeHourResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "teacherCoreUserId": {
            "type": "string",
            "description": "ค่า sub ของอาจารย์เจ้าของเวลา"
          },
          "teacherPersonCode": {
            "type": "string",
            "nullable": true,
            "description": "รหัสบุคลากรจาก Core Hub (แสดงแทนชื่อ)"
          },
          "dayOfWeek": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI"
            ]
          },
          "startTime": {
            "type": "string",
            "example": "09:00",
            "description": "เวลาท้องถิ่น Asia/Bangkok รูปแบบ HH:mm"
          },
          "endTime": {
            "type": "string",
            "example": "12:00"
          },
          "slotMinutes": {
            "type": "number",
            "example": 30
          },
          "isAvailable": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "teacherCoreUserId",
          "teacherPersonCode",
          "dayOfWeek",
          "startTime",
          "endTime",
          "slotMinutes",
          "isAvailable",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateOfficeHourDto": {
        "type": "object",
        "properties": {
          "dayOfWeek": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI"
            ],
            "example": "MON"
          },
          "startTime": {
            "type": "string",
            "example": "09:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endTime": {
            "type": "string",
            "example": "12:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "slotMinutes": {
            "type": "number",
            "minimum": 5,
            "maximum": 240,
            "default": 30,
            "description": "ความยาวของช่วงนัด 1 ช่วง (นาที)"
          },
          "isAvailable": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "dayOfWeek",
          "startTime",
          "endTime"
        ]
      },
      "UpdateOfficeHourDto": {
        "type": "object",
        "properties": {
          "dayOfWeek": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI"
            ],
            "example": "MON"
          },
          "startTime": {
            "type": "string",
            "example": "09:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "endTime": {
            "type": "string",
            "example": "12:00",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "slotMinutes": {
            "type": "number",
            "minimum": 5,
            "maximum": 240,
            "default": 30,
            "description": "ความยาวของช่วงนัด 1 ช่วง (นาที)"
          },
          "isAvailable": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "DeletedModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deleted": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "deleted"
        ]
      },
      "BookingExceptionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "teacherCoreUserId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE"
            ]
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "teacherCoreUserId",
          "startsAt",
          "endsAt",
          "status",
          "reason",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateBookingExceptionDto": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-05T12:00:00+07:00"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-05T13:00:00+07:00"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE"
            ],
            "description": "AVAILABLE = เปิดเวลานี้ให้จอง · UNAVAILABLE = ปิดเวลานี้"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "status"
        ]
      },
      "BookingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "teacherCoreUserId": {
            "type": "string",
            "description": "ค่า sub ของอาจารย์"
          },
          "teacherPersonCode": {
            "type": "string",
            "nullable": true,
            "description": "รหัสบุคลากรจาก Core Hub (แสดงแทนชื่อ)"
          },
          "studentCoreUserId": {
            "type": "string",
            "description": "ค่า sub ของนักศึกษา"
          },
          "studentPersonCode": {
            "type": "string",
            "nullable": true,
            "description": "รหัสนักศึกษาจาก Core Hub (แสดงแทนชื่อ)"
          },
          "studentFullNameTh": {
            "type": "string",
            "nullable": true,
            "description": "ชื่อนักศึกษา อ่านจาก Core Hub ตอนเปิดดูรายการเดียวและเฉพาะผู้ที่มีสิทธิ์อ่านข้อมูลบุคคล — ไม่เก็บในฐานข้อมูล"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "topic": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CANCELLED",
              "COMPLETED"
            ]
          },
          "unreadCount": {
            "type": "number",
            "description": "จำนวนข้อความในคิวนี้ที่อีกฝ่ายส่งมาและยังไม่ได้อ่าน"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "teacherCoreUserId",
          "teacherPersonCode",
          "studentCoreUserId",
          "studentPersonCode",
          "studentFullNameTh",
          "startsAt",
          "endsAt",
          "topic",
          "status",
          "unreadCount",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "studentPersonCode": {
            "type": "string",
            "example": "6704101312",
            "maxLength": 50
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-12T09:00:00+07:00"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-12T09:30:00+07:00"
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "ปรึกษาโครงงานพิเศษ"
          }
        },
        "required": [
          "studentPersonCode",
          "startsAt",
          "endsAt",
          "topic"
        ]
      },
      "ChatMessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "senderCoreUserId": {
            "type": "string",
            "description": "ค่า sub ของผู้ส่ง — เทียบกับ id จาก GET /api/v1/me เพื่อรู้ว่าเป็นข้อความของเราหรือไม่"
          },
          "message": {
            "type": "string"
          },
          "isRead": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "bookingId",
          "senderCoreUserId",
          "message",
          "isRead",
          "createdAt"
        ]
      },
      "CreateChatMessageDto": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "example": "สวัสดี ขอเลื่อนนัดได้ไหม"
          }
        },
        "required": [
          "bookingId",
          "message"
        ]
      },
      "SlotBookingModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "studentPersonCode": {
            "type": "string",
            "nullable": true,
            "description": "รหัสนักศึกษา (แสดงแทนชื่อ)"
          },
          "topic": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CANCELLED",
              "COMPLETED"
            ]
          }
        },
        "required": [
          "id",
          "studentPersonCode",
          "topic",
          "status"
        ]
      },
      "ScheduleSlotResponse": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "BOOKED"
            ]
          },
          "bookedByMe": {
            "type": "boolean",
            "description": "นัดหมายในช่วงนี้เป็นของผู้เรียกเอง"
          },
          "booking": {
            "nullable": true,
            "description": "รายละเอียดนัดหมาย — เห็นเฉพาะอาจารย์เจ้าของตารางและผู้ดูแลระบบ คนอื่นเห็นแค่ว่าไม่ว่าง",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SlotBookingModel"
              }
            ]
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "status",
          "bookedByMe",
          "booking"
        ]
      },
      "TeacherResponse": {
        "type": "object",
        "properties": {
          "coreUserId": {
            "type": "string",
            "description": "ค่า sub ของอาจารย์ — ใช้เป็น teacherCoreUserId ในคำขออื่น"
          },
          "personCode": {
            "type": "string",
            "nullable": true,
            "description": "รหัสบุคลากรจาก Core Hub (แสดงแทนชื่อ)"
          }
        },
        "required": [
          "coreUserId",
          "personCode"
        ]
      },
      "HealthModel": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "csmju-q-teacher"
          }
        }
      },
      "MeModel": {
        "type": "object",
        "required": [
          "id",
          "email",
          "coreRole",
          "subsystemRole",
          "session"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "ค่า sub ของผู้ใช้ใน Core Hub (ไม่ใช่ UUID เสมอไป)"
          },
          "email": {
            "type": "string",
            "description": "ใช้แสดงผลเท่านั้น ห้ามใช้เป็นกุญแจ"
          },
          "coreRole": {
            "type": "string",
            "example": "lecturer"
          },
          "subsystemRole": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER",
              "ADMIN"
            ]
          },
          "session": {
            "type": "object",
            "required": [
              "expiresAt"
            ],
            "properties": {
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
